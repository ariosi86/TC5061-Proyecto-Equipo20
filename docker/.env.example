# Copiar a docker/.env para cambiar valores. Todas las variables son opcionales:
# docker-compose.yml trae estos mismos valores por defecto.

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=mibici-equipo20
MLFLOW_PUERTO=5001

# Puertos publicados de las APIs y monitoreo
API_P1_PUERTO=8001
API_P2_PUERTO=8002
API_P3_PUERTO=8003
EVIDENTLY_PUERTO=8000
EVIDENTLY_API_URL=http://evidently:8000

# Límites de recursos por contenedor (base del análisis FinOps).
# MLflow 3 necesita ~2 GB con 2 workers; con 1 GB sus procesos se caen por memoria.
API_CPUS=1.0
API_MEMORIA=1g
MLFLOW_CPUS=1.0
MLFLOW_MEMORIA=2g
EVIDENTLY_CPUS=1.0
EVIDENTLY_MEMORIA=1g

# 1 = reentrenar y volver a registrar los campeones aunque ya existan
FORZAR_ENTRENAMIENTO=0

# Segundos que cada API reutiliza el modelo antes de volver a consultar MLflow.
# 0 = descargarlo en cada petición (línea base de Locust: 3.3 inferencias/s y p95 de 31 s con 100 usuarios)
CACHE_TTL_SEG=60
