# syntax=docker/dockerfile:1
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY docker/api/requirements.txt docker/constraints.txt ./
# Caché de pip de BuildKit: reconstruir o reintentar no vuelve a descargar los paquetes
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install --retries 10 --timeout 120 -c constraints.txt -r requirements.txt

COPY docker/api/ .

EXPOSE 8000

ENV MLFLOW_TRACKING_URI=http://mlflow:5000

# CMD para FastAPI + uvicorn
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
