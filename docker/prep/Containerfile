# syntax=docker/dockerfile:1
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Dependencias primero (capa cacheada mientras requirements.txt no cambie)
COPY requirements.txt pyproject.toml README.md LICENSE docker/constraints.txt ./
COPY proyecto_mibici/__init__.py proyecto_mibici/__init__.py
# Caché de pip de BuildKit: reconstruir o reintentar no vuelve a descargar los paquetes
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install --retries 10 --timeout 120 -c constraints.txt -r requirements.txt

# Código local del repositorio (lo que se prueba es lo que está en la rama, no main de GitHub)
COPY . .

COPY docker/prep/entrypoint.sh /usr/local/bin/prep-entrypoint.sh
RUN chmod +x /usr/local/bin/prep-entrypoint.sh

CMD ["sh", "/usr/local/bin/prep-entrypoint.sh"]
