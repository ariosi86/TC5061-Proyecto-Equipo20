FROM python:3.10-slim

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir mlflow[extras]>=2.15.0

EXPOSE 5000

CMD ["mlflow", "server", \
     "--backend-store-uri", "sqlite:///mlflow.db", \
     "--default-artifact-root", "./mlruns", \
     "--host", "0.0.0.0", "--port", "5000", \
     "--serve-artifacts", \
     "--artifacts-destination", "./mlruns", \
     "--allowed-hosts", "mlflow,mlflow:5000,localhost,localhost:*,127.0.0.1,127.0.0.1:*,host.docker.internal,host.docker.internal:5001,10.*,192.168.*,127.0.0.1,127.0.0.1:*"]
